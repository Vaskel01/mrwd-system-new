# Server-only configuration.
# Copy to server/.env for local development.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or CRON_SECRET in a VITE_* variable.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Required for production administration, Auth Admin operations, System Health,
# and scheduled-report processing. Use a Supabase server Secret/service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# Random long secret protecting the scheduled-report cron endpoint.
CRON_SECRET=

PORT=4000
CORS_ORIGIN=http://localhost:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
