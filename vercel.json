{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "crons": [
    { "path": "/api/production/cron/run-reports", "schedule": "15 0 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
